          "priorityLevel": 0,
          "schedulingMode": 0,
          "seenCount": 5,
          "cards": [
            {
              "text": "2 Peter 3:9\n\nThe Lord is not slow to fulfill his promise as some count slowness,\nbut is patient toward you, not wishing that any should perish, but\nthat all should reach repentance.",
              "ordering": 0,
              "createdDate": "2026-08-30T17:21:45.769480Z",
              "stackGroup": "5863c468-8016-4bd1-bfca-52f02af1ef0b",
              "threadId": "3dc8700c-cf21-40ed-a263-26880d2f5ea9",
              "archived": false,
              "stackOrder": -2,
              "eventReminder": false,
              "lastPrayed": "2026-10-17T08:53:43.610527Z",
              "seenCount": 4,
              "isMarkdown": false
            },
            {
              "text": "God controls his will with perfect endurance in the face of pain or\nany other provocation.",
              "ordering": 0,
              "createdDate": "2026-08-30T17:19:18.753430Z",
              "stackGroup": "290a9238-87a1-486d-a8d5-33e7d38b3423",
