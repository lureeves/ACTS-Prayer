          "priorityLevel": 0,
          "schedulingMode": 0,
          "seenCount": 4,
          "cards": [
            {
              "text": "God is fully present everywhere at all times. He is not bound by physical space or limitations, meaning his entire being is present in every location throughout the universe simultaneously.",
