          "priorityLevel": 0,
          "schedulingMode": 0,
          "seenCount": 4,
          "cards": [
            {
              "text": "Lamentations 3:22-23\n\nThe steadfast love of the LORD never ceases; his mercies never\ncome to an end; they are new every morning; great is your\nfaithfulness.",
              "ordering": 0,
              "createdDate": "2026-08-26T13:04:03.328328Z",
