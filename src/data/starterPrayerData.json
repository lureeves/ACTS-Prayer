              "archived": false,
              "stackOrder": 0,
              "eventReminder": false,
              "lastPrayed": "2026-10-17T08:53:43.611503Z",
              "seenCount": 4,
              "isMarkdown": false
            },
            {
              "text": "Pslam 86:15\n\nBut you, O Lord, are a God merciful and gracious, slow to anger\nand abouding in steadfast love and faithfulness.",
              "ordering": 0,
              "createdDate": "2026-08-30T17:22:01.955036Z",
              "stackGroup": "2a2fb072-74cf-41e8-b9fc-fe5b6ad34802",
              "threadId": "d7096d87-f717-4a0d-bbb3-be87cc6f3ff3",
              "archived": false,
              "stackOrder": -3,
              "eventReminder": false,
              "lastPrayed": "2026-10-17T08:53:43.609803Z",
              "seenCount": 4,
              "isMarkdown": false
            },
            {
              "text": "1 Timothy 1:16\n\nBut I received mercy for this reason, that in me, as the foremost,\nJesus Christ might display his perfect patience as an example to\nthose who were to believe in him for eternal life.",
              "ordering": 0,
              "createdDate": "2026-08-30T17:19:40.336696Z",
              "stackGroup": "5b567a69-12eb-4620-b8f2-c44e1ee48fd5",
              "threadId": "e28cad90-321e-4bed-a2b4-ef35b7b3ad60",
              "archived": false,
              "stackOrder": -1,
              "eventReminder": false,
              "lastPrayed": "2026-10-17T08:53:43.611007Z",
              "seenCount": 4,
              "isMarkdown": false
            }
          ]
