              "seenCount": 3,
              "isMarkdown": false
            },
            {
              "text": "God is the uncreated maker of all things, speaking the universe into existence from nothing and sustaining it by his infinite power.",
              "ordering": 0,
              "createdDate": "2026-09-09T12:55:25.647947Z",
              "stackGroup": "02eb4aae-1cab-4934-b28b-73007533353c",
              "threadId": "44e9a079-7193-421f-961c-008d23b81b10",
